{
  "name": "chol",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "bin": {
    "gateway": "bin/cdk.js"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "cdk:synth": "cdk synth",
    "cdk:dsql": "cdk --profile k-faas deploy CholDsql",
    "cdk:lambda": "cdk --profile k-faas deploy CholLambda",
    "cdk:deploy": "cdk --profile k-faas deploy kDeployment",
    "cdk:gateway": "cdk --profile k-faas deploy kGateway",
    "cdk:acm": "cdk --profile k-faas deploy CholAcm",
    "cdk:s3": "npm --prefix .. run build:web && cdk --profile k-faas deploy CholS3 && bash ./bin/invalidate-frontend.sh k-faas CholFrontendDistributionId '/*'",
    "cdk:cf": "cdk --profile k-faas deploy CholCloudFront"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.160",
    "@types/node": "^24.5.2",
    "aws-cdk": "^2.1111.0",
    "aws-cdk-lib": "^2.215.0",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@aws-cdk/aws-lambda-go-alpha": "^2.215.0-alpha.0",
    "@aws-sdk/client-ssm": "^3.1005.0",
    "@aws/aurora-dsql-node-postgres-connector": "^0.1.8",
    "@types/lodash": "^4.17.24",
    "constructs": "^10.5.0",
    "datadog-cdk-constructs-v2": "^3.9.0",
    "dotenv": "^17.3.1",
    "es-toolkit": "^1.44.0",
    "faas-spec": "^1.0.0",
    "faas-stack": "^1.0.1",
    "faas-util": "^1.0.0",
    "lodash": "^4.17.23",
    "pg": "^8.20.0",
    "pg-connection-string": "^2.12.0",
    "source-map-support": "^0.5.21"
  }
}

{
  "compilerOptions": {
    "esModuleInterop": true,
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["es2022"],
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": false,
    "inlineSourceMap": true,
    "inlineSources": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types"],
  },
  "exclude": [
    "node_modules",
    "cdk.out",
    "lib/construct/auto-spec/src",
    "lib/construct/auto-spec/test",
    "lib/construct/auto-spec/dist",
  ],
}
